# 复制为 .env 后按实际情况修改：cp .env.example .env

# 服务器公网 IP（必须与补丁写入 TDesktop 的 server_ip 一致）
PUBLIC_IP=1.2.3.4
# 逻辑 DC id；客户端补丁里写死的是 1，保持 1 即可
SERVER_ID=1

# 与客户端 CMake 参数 TDESKTOP_API_ID / TDESKTOP_API_HASH 必须一致
# 默认值是 Telegram 官方测试凭据，仅用于本地实验
API_ID=17349
API_HASH=344583e45741c457fe1862106095a5eb

# 短信登录模拟：服务端接受的固定验证码
AUTH_CODE=123456
# 1 = 打印解密后的 TL（调试用），0 = 关闭
LOG_TL=0

# 运行时热更新服务器地址的管理接口（只监听本机，勿暴露到公网）
ADMIN_HOST=127.0.0.1
ADMIN_PORT=18080
# 设置后访问管理接口需 Authorization: Bearer <token>
ADMIN_TOKEN=

# 服务端 RSA 私钥，PKCS#1 PEM。生成方式见 docs/setup.md。
# Compose v2.24+ 的 .env 支持带引号的多行值；请粘贴真实 PEM，而不是占位符。
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEowIBAAKCAQEA替换为自己的私钥
-----END RSA PRIVATE KEY-----"

# 本地调试代理示例 —— 127.0.0.1:7897 只在你的本机有效！
# ⚠️ 切勿把 127.0.0.1:7897 写进 GitHub Actions secrets 或 VPS 的 .env：
# CI runner 和 VPS 上的 127.0.0.1 不是你的电脑，会导致构建/部署失败。
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
